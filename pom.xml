<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.tobyjamesclements</groupId>
    <artifactId>parsley</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Parsley</name>
    <description>Causal delivery order for Kafka Streams processors via vector clocks.</description>
    <url>https://github.com/tobyjamesclements/parsley</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/tobyjamesclements/parsley/blob/main/LICENSE</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>tobyjamesclements</id>
            <name>tobyjamesclements</name>
            <url>https://github.com/tobyjamesclements</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/tobyjamesclements/parsley.git</connection>
        <developerConnection>scm:git:https://github.com/tobyjamesclements/parsley.git</developerConnection>
        <url>https://github.com/tobyjamesclements/parsley</url>
    </scm>

    <repositories>
        <!-- Confluent artifacts (Avro serdes, Schema Registry client) are not on Maven Central.
             Used only by the test scope. -->
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

    <!-- Snapshots publish to Sonatype Central via a separate deploy invocation rather than this
         element (CI: .github/workflows/publish.yml; locally:
         mvn deploy -DskipTests -DaltSnapshotDeploymentRepository=central::https://central.sonatype.com/repository/maven-snapshots/
         which requires a matching <server id="central"> entry in your own ~/.m2/settings.xml). Real
         releases go through the release profile's central-publishing-maven-plugin, which uploads via
         Central's bundle API rather than a repository URL. Neither path needs
         <distributionManagement>, so there is none here. -->

    <properties>
        <kafka.version>4.3.1</kafka.version>
        <confluent.version>8.3.0</confluent.version>
        <avro.version>1.12.1</avro.version>
        <maven.compiler.release>25</maven.compiler.release>
        <jspecify.version>1.0.0</jspecify.version>
        <!-- NullAway 0.13.7 requires Error Prone >= 2.50.0; both run on JDK 25. -->
        <errorprone.version>2.50.0</errorprone.version>
        <nullaway.version>0.13.7</nullaway.version>
        <pitest.version>1.25.7</pitest.version>
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
        <jacoco.version>0.8.15</jacoco.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Align all transitive Jackson artifacts to one version. Avro 1.11.x pins
                 jackson-core low (2.14.3) while newer test deps bring jackson-databind 2.21.x;
                 the BOM keeps core/databind/annotations in lock-step so Avro schema parsing works. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.22.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- JSpecify nullness annotations (@NullMarked/@Nullable). Runtime-retained and tiny with no
             transitive deps; shipped so downstream callers (incl. Kotlin) see the null contracts. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <!-- Optional: only CausalConsumer and CausalProcessorSupplier users need this at runtime.
             Producer-only dependents should not receive it transitively. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams</artifactId>
            <version>${kafka.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- SLF4J API for operational logging; the binding is supplied by the host application
             (Kafka Streams itself requires one at runtime). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.18</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams-test-utils</artifactId>
            <version>${kafka.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Confluent Avro serdes + Schema Registry client (incl. MockSchemaRegistry). Pulls in
             kafka-avro-serializer, kafka-schema-registry-client, and org.apache.avro:avro. -->
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-streams-avro-serde</artifactId>
            <version>${confluent.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Pinned explicitly so the generated SpecificRecord classes match the runtime Avro. -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.18</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Benchmarks: mvn -Pbenchmarks test
             Runs the JMH suite in-process on TopologyTestDriver + local RocksDB (no broker, no Docker).
             Point RocksDB at the target machine's real storage for representative figures via:
               -Dparsley.bench.state.store.dir=/mnt/nvme/parsley-bench
             Pass JMH flags via:
               -Dbenchmark.args="-wi 1 -i 1 -f 1 -p n=8 -p k=1 -p r=1" -->
        <profile>
            <id>benchmarks</id>
            <properties>
                <!-- Defaults; override on the command line with -Dproperty=value -->
                <benchmark.args></benchmark.args>
                <parsley.bench.state.store.dir></parsley.bench.state.store.dir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>run-benchmarks</id>
                                <phase>test</phase>
                                <!-- exec:exec forks a real JVM so that JMH's per-benchmark fork
                                     can find ForkedMain on the classpath. exec:java runs in-process
                                     within Maven and breaks JMH's classpath discovery. -->
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>java</executable>
                                    <classpathScope>test</classpathScope>
                                    <arguments>
                                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <argument>-Dparsley.bench.state.store.dir=${parsley.bench.state.store.dir}</argument>
                                        <argument>-Dbenchmark.args=${benchmark.args}</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>io.github.tobyjamesclements.parsley.BenchmarkRunner</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Mutation testing: mvn -Pmutation test
             Reports land in target/pit-reports/index.html. Broker ITs (Testcontainers)
             are excluded from mutant-by-mutant execution. -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <excludedTestClasses>
                                <param>io.github.tobyjamesclements.parsley.*IT</param>
                            </excludedTestClasses>
                        </configuration>
                        <executions>
                            <execution>
                                <id>mutation-coverage</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Real Central release: mvn -Prelease deploy (only the tag-triggered release.yml workflow
             uses this; the snapshot path on every CI run stays on plain maven-deploy-plugin and never
             activates this profile). Signs artifacts, attaches sources/javadoc jars, and bundles+
             uploads the release to Central via the Publisher API instead of a plain repository PUT. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <passphraseEnvName>MAVEN_GPG_PASSPHRASE</passphraseEnvName>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Adds a jar-producing execution to the unconditional maven-javadoc-plugin
                         declaration above (Maven merges profile and main-build plugin entries sharing
                         the same key), so -javadoc.jar is only built for a real release. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <!-- Error Prone reaches into javac internals, so it must run in a forked compiler JVM
                     with the compiler module's packages exported/opened (required on JDK 16+). Only
                     NullAway is enabled (-XepDisableAllChecks); io.github.tobyjamesclements.parsley is the @NullMarked surface.
                     Main sources fail on a nullness violation (ERROR); tests warn only (WARN) since the
                     test suite shares the io.github.tobyjamesclements.parsley package but is not yet null-clean. -->
                <configuration>
                    <proc>full</proc>
                    <fork>true</fork>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>1.37</version>
                        </path>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${errorprone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=io.github.tobyjamesclements.parsley -XepOpt:NullAway:KnownInitializers=org.apache.kafka.streams.processor.api.Processor.init</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:WARN -XepOpt:NullAway:AnnotatedPackages=io.github.tobyjamesclements.parsley -XepOpt:NullAway:KnownInitializers=org.apache.kafka.streams.processor.api.Processor.init</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Generates test-only SpecificRecord classes from src/test/avro/*.avsc. -->
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>${avro.version}</version>
                <executions>
                    <execution>
                        <id>generate-test-avro</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/test/avro</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-test-sources/avro</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- avro-maven-plugin's schema goal always calls project.addCompileSourceRoot(),
                 registering its output as a main source root. This re-registers it as a test
                 source root instead so generated SpecificRecord classes never ship in the jar.
                 build-helper is the standard solution; avro-maven-plugin 1.11.x has no test-schema goal. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-test-avro-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-test-sources/avro</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!-- @{argLine} (not ${argLine}) picks up the javaagent flag that jacoco:prepare-agent
                         sets on the "argLine" property at execution time, after the static pom is parsed. -->
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
            <!-- Unit test coverage. Scoped to surefire's *Test classes (not the Testcontainers ITs),
                 matching the existing mutation-testing exclusion of io.github.tobyjamesclements.parsley.*IT below. Report lands
                 at target/site/jacoco/ as part of plain 'mvn test'.

                 'check' gates on the BUNDLE total only, not per-class: several classes (ParsleyTopicAdmin,
                 ParsleyKafkaEpochTransport, CausalStream, ...) are broker-dependent and legitimately
                 exercised only by the ITs this report excludes, so a per-class minimum would fail the
                 build on files with no real gap. Thresholds sit a few points below the baseline this
                 report measured (86.0% instructions / 80.9% branches) so routine refactors don't trip it,
                 but a real coverage regression fails 'mvn test' (and therefore CI) directly. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>argLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- IT tests (Testcontainers/broker-dependent) run in the integration-test phase.
                 Use 'mvn test' for fast tests only; 'mvn verify' for the full suite. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <!-- Docker API 1.32 (Testcontainers default) is rejected by Docker 29.x (min 1.40) -->
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.tobyjamesclements.parsley</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <doclint>none</doclint>
                    <overview>${project.basedir}/overview.html</overview>
                    <!-- avro-maven-plugin registers its test-avro output dir as a main compile source
                         root too (see comment above build-helper-maven-plugin); those test-only
                         generated classes never actually land in the main jar, so excluded here to
                         avoid javadoc failing on a package with no real main-module source. -->
                    <excludePackageNames>io.github.tobyjamesclements.parsley.avro</excludePackageNames>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest.junit5.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <failWhenNoMutations>false</failWhenNoMutations>
                        <timestampedReports>false</timestampedReports>
                        <outputFormats>
                            <outputFormat>HTML</outputFormat>
                            <outputFormat>XML</outputFormat>
                        </outputFormats>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
