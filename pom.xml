<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.tobyjamesclements</groupId>
    <artifactId>parsley</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Parsley</name>
    <description>Causal delivery order for Kafka stream processing. A functional core —
        pure handlers and folds over typed topics — with imperative edges on Kafka Streams,
        verified by a deterministic simulator with a ground-truth causal oracle.</description>
    <url>https://github.com/tobyjamesclements/parsley</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/tobyjamesclements/parsley/blob/main/LICENSE</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>tobyjamesclements</id>
            <name>Toby Clements</name>
            <url>https://github.com/tobyjamesclements</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/tobyjamesclements/parsley.git</connection>
        <developerConnection>scm:git:https://github.com/tobyjamesclements/parsley.git</developerConnection>
        <url>https://github.com/tobyjamesclements/parsley</url>
    </scm>

    <!-- Snapshots publish to Sonatype Central via a separate deploy invocation rather than this
         element (CI: .github/workflows/publish.yml). Real releases go through the release
         profile's central-publishing-maven-plugin, which uploads via Central's bundle API rather
         than a repository URL. Neither path needs <distributionManagement>, so there is none. -->

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kafka.version>4.3.1</kafka.version>
        <pitest.threads>1</pitest.threads>
        <junit.version>5.11.4</junit.version>
        <slf4j.version>2.0.18</slf4j.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <!-- The broker smoke suite (-Pbroker-it) runs against the minimum supported broker,
             so the version floor stated in the docs is the one actually tested. -->
        <broker.image>apache/kafka:3.7.2</broker.image>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <!-- Inherited, though only the Streams adapter touches it: the documented runtime path
             is Kafka Streams, so an application that resolved kafka-clients alone could not run
             the getting-started example. Inheriting both from here also keeps them on one
             ${kafka.version} by construction. An application using only the plain-client edge
             (CausalClock, CausalHeaders) reaches nothing under org.apache.kafka.streams and can
             exclude it, along with the RocksDB and Jackson trees it carries. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Optional, like kafka-streams: ContractProbes drives TopologyTestDriver, and is
             meant to run from an application's test suite where test-utils is present.
             Production classpaths never need it. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams-test-utils</artifactId>
            <version>${kafka.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!-- Keep every temporary file the test JVMs create inside target/, where
                         `mvn clean` sweeps it, instead of the OS temp directory, where nothing
                         does. RocksDB extracts its 9 MB native library to a fresh temp file per
                         JVM and relies on deleteOnExit to remove it; that hook only runs on a
                         graceful shutdown, so every forcibly killed test JVM stranded a copy.
                         2833 of them, 25 GB, had built up by 2026-08-01 (#64).

                         ROCKSDB_SHAREDLIB_DIR would collapse this to one reused file, but it is
                         unsafe: concurrent JVMs each delete and rewrite that one path on
                         startup, and a thread whose load fails midway leaves RocksDB's static
                         LibraryState stuck at LOADING, which every other thread in the JVM then
                         spins on forever. Measured under -Dpitest.threads=4: minions hung in
                         RocksDB.loadLibrary and the build never finished. Per-JVM temp files are
                         what the loader is designed for; only their location needed fixing. -->
                    <argLine>-Djava.io.tmpdir=${project.build.directory}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <!-- The conformance kit (docs/reference/conformance-kit.md): the
                             simulator, oracle, and protocol tests as a consumable artifact, so
                             a vendored copy or an alternative host can run the verification
                             this library's own guarantees rest on. The broker *IT classes stay
                             out: the kit must run without Docker or Testcontainers. -->
                        <id>conformance-kit</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>**/*IT.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.25.8</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>io.github.tobyjamesclements.parsley.*</param>
                    </targetClasses>
                    <!-- The broker smoke suite needs Docker and runs under failsafe in the
                         broker-it profile only; PIT's coverage run must not start containers. -->
                    <excludedTestClasses>
                        <param>*IT</param>
                    </excludedTestClasses>
                    <!-- Serial. The only timing-sensitive verdict PIT produces is TIMED_OUT:
                         a mutant slowed by CPU contention times out and is scored as a kill,
                         so a threaded run can inflate the score under load. One thread removes
                         that hazard outright instead of periodically re-checking for it, and
                         costs little: measured on this suite at 506s serial against 402s at
                         four threads, with all 738 verdicts identical between the two and
                         across repeated runs of each. Raise it with -Dpitest.threads=N for
                         local iteration; the gate stays at one. -->
                    <threads>${pitest.threads}</threads>
                    <!-- Both floors guard against regression; the scores stand a few points
                         above them so honest refactoring noise does not flake the build. -->
                    <mutationThreshold>75</mutationThreshold>
                    <coverageThreshold>80</coverageThreshold>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <!-- Minions are killed rather than shut down, so they stranded every one of
                         the RocksDB libraries surefire's argLine above describes; surefire's own
                         setting does not reach them. -->
                    <jvmArgs>
                        <param>-Djava.io.tmpdir=${project.build.directory}</param>
                    </jvmArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>mutation-floor</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The broker smoke suite: failsafe runs the *IT classes against a real broker in a
             Docker container (Testcontainers). Kept out of the default gate so `mvn clean
             verify` stays Docker-free; CI runs it as a separate non-gating workflow. -->
        <profile>
            <id>broker-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.2</version>
                        <configuration>
                            <systemPropertyVariables>
                                <parsley.broker.image>${broker.image}</parsley.broker.image>
                            </systemPropertyVariables>
                            <!-- As surefire: keep temporary files out of the OS temp directory. -->
                            <argLine>-Djava.io.tmpdir=${project.build.directory}</argLine>
                        </configuration>
                        <executions>
                            <execution>
                                <id>broker-smoke</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Central-release artifacts and signatures; activated by the release workflow only. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <passphraseEnvName>MAVEN_GPG_PASSPHRASE</passphraseEnvName>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
