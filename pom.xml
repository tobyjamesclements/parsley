<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.tobyjamesclements</groupId>
    <artifactId>parsley</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Parsley</name>
    <description>Causal delivery order for Kafka stream processing. A functional core —
        pure handlers and folds over typed topics — with imperative edges on Kafka Streams,
        verified by a deterministic simulator with a ground-truth causal oracle.</description>
    <url>https://github.com/tobyjamesclements/parsley</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/tobyjamesclements/parsley/blob/main/LICENSE</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>tobyjamesclements</id>
            <name>Toby Clements</name>
            <url>https://github.com/tobyjamesclements</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/tobyjamesclements/parsley.git</connection>
        <developerConnection>scm:git:https://github.com/tobyjamesclements/parsley.git</developerConnection>
        <url>https://github.com/tobyjamesclements/parsley</url>
    </scm>

    <!-- Snapshots publish to Sonatype Central via a separate deploy invocation rather than this
         element (CI: .github/workflows/publish.yml). Real releases go through the release
         profile's central-publishing-maven-plugin, which uploads via Central's bundle API rather
         than a repository URL. Neither path needs <distributionManagement>, so there is none. -->

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kafka.version>4.3.1</kafka.version>
        <pitest.threads>4</pitest.threads>
        <junit.version>5.11.4</junit.version>
        <slf4j.version>2.0.18</slf4j.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <!-- The broker smoke suite (-Pbroker-it) runs against the minimum supported broker,
             so the version floor stated in the docs is the one actually tested. -->
        <broker.image>apache/kafka:3.7.2</broker.image>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <!-- Optional: only the Streams adapter touches kafka-streams; the protocol core and the
             edge ops need kafka-clients at most. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams</artifactId>
            <version>${kafka.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams-test-utils</artifactId>
            <version>${kafka.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <!-- The conformance kit (docs/reference/conformance-kit.md): the
                             simulator, oracle, and protocol tests as a consumable artifact, so
                             a vendored copy or an alternative host can run the verification
                             this library's own guarantees rest on. The broker *IT classes stay
                             out: the kit must run without Docker or Testcontainers. -->
                        <id>conformance-kit</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>**/*IT.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.25.7</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>io.github.tobyjamesclements.parsley.*</param>
                    </targetClasses>
                    <!-- The broker smoke suite needs Docker and runs under failsafe in the
                         broker-it profile only; PIT's coverage run must not start containers. -->
                    <excludedTestClasses>
                        <param>*IT</param>
                    </excludedTestClasses>
                    <!-- Four threads is measured as verdict-identical to a serial run on this
                         suite (a timeout under CPU contention would count as a kill, so this
                         is re-checked when the suite slows: run once with -Dpitest.threads=1
                         and diff mutations.xml). Overridable per run. -->
                    <threads>${pitest.threads}</threads>
                    <!-- Both floors guard against regression; the scores stand a few points
                         above them so honest refactoring noise does not flake the build. -->
                    <mutationThreshold>75</mutationThreshold>
                    <coverageThreshold>80</coverageThreshold>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                </configuration>
                <executions>
                    <execution>
                        <id>mutation-floor</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The broker smoke suite: failsafe runs the *IT classes against a real broker in a
             Docker container (Testcontainers). Kept out of the default gate so `mvn clean
             verify` stays Docker-free; CI runs it as a separate non-gating workflow. -->
        <profile>
            <id>broker-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.2</version>
                        <configuration>
                            <systemPropertyVariables>
                                <parsley.broker.image>${broker.image}</parsley.broker.image>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <id>broker-smoke</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Central-release artifacts and signatures; activated by the release workflow only. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <passphraseEnvName>MAVEN_GPG_PASSPHRASE</passphraseEnvName>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
