# IntelliJ IDEA
.idea/

# Target directories
target/

# flatten-maven-plugin output (the consumer-facing POM generated on every build)
.flattened-pom.xml

# MkDocs build output
site/

# MkDocs toolchain for scripts/docs-build.sh; not a build dependency of the library
.venv/

# Generated Javadoc staged into docs source for versioned builds
docs/javadoc/

# Concatenated docs generated from docs/llms.txt by scripts/build-llms-full.py
docs/llms-full.txt

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
# Agent tool state: machine-specific, never tracked. The tracked guidance is AGENTS.md.
.claude/
/parsley.iml
