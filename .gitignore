# IntelliJ IDEA
.idea/

# Target directories
target/

# flatten-maven-plugin output (the consumer-facing POM generated on every build)
.flattened-pom.xml

# MkDocs build output
site/

# Generated Javadoc staged into docs source for versioned builds
docs/api/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
# Claude Code local state: machine-specific, never tracked. CLAUDE.md itself is tracked.
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
/parsley.iml
